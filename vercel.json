{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "UV_PYTHON": "3.12",
      "PYTHON_VERSION": "3.12"
    }
  },
  "env": {
    "UV_PYTHON": "3.12",
    "PYTHON_VERSION": "3.12"
  },
  "functions": {
    "api/index.py": {
      "includeFiles": "ml/{models/flood_risk_pipeline.pkl,models/label_encoder.pkl,models/model_metadata.json,api.py}",
      "excludeFiles": "{dist/**,public/**,src/**,ml/topo/**,ml/experiments/**,ml/tests/**,ml/models/legacy_baseline_82/**,ml/models/flood_risk_model.pkl,ml/*.zip,ml/*.png,ml/*.ipynb,*.md}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
