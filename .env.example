# Konfigurasi Environment B-DRAIN

# Deployment Vercel Monorepo (Fullstack):
# Jika frontend dan backend di-deploy dalam satu project Vercel yang sama,
# VITE_ML_API_URL TIDAK PERLU diisi (default production otomatis menggunakan relative path /api).

# Development lokal:
# Backend Flask lokal berjalan pada http://localhost:5000
# Jika tidak diisi, frontend saat development otomatis mengarah ke http://localhost:5000.
# VITE_ML_API_URL=http://localhost:5000

# Opsional: Jika backend di-host di layanan terpisah (misal Render/VPS eksternal):
# VITE_ML_API_URL=https://bdrain-ml-api.onrender.com
